{
  "name": "focussive",
  "version": "1.0.0",
  "private": true,
  "description": "ADHD Focus Session Management System",
  "scripts": {
    "dev:backend": "pnpm -F @focussive/backend dev",
    "dev:mobile": "pnpm -F @focussive/mobile start",
    "dev:extension": "pnpm -F @focussive/extension dev",
    "build:shared": "pnpm -F @focussive/shared build",
    "build:backend": "pnpm -F @focussive/backend build",
    "build:extension": "pnpm -F @focussive/extension build",
    "build:mobile": "pnpm -F @focussive/mobile android",
    "build:mobile:release": "pnpm -F @focussive/mobile android:release",
    "build:mobile:dev": "pnpm -F @focussive/mobile build:dev",
    "build:mobile:preview": "pnpm -F @focussive/mobile build:preview",
    "build:mobile:prod": "pnpm -F @focussive/mobile build:prod",
    "build:mobile:prod-apk": "pnpm -F @focussive/mobile build:prod-apk",
    "typecheck": "tsc -p packages/shared/tsconfig.json --noEmit && tsc -p packages/backend/tsconfig.json --noEmit && tsc -p packages/mobile/tsconfig.json --noEmit && tsc -p packages/extension/tsconfig.json --noEmit",
    "test-db": "pnpm -F @focussive/backend test-db",
    "clean": "pnpm -r run clean",
    "heroku-prebuild": "npm install -g pnpm@10.33.2",
    "heroku-postbuild": "pnpm install && pnpm -F @focussive/shared build && pnpm -F @focussive/backend build",
    "start": "node packages/backend/dist/server.js"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": "10.33.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt",
      "esbuild"
    ]
  },
  "dependencies": {
    "expo": "~56.0.12",
    "react": "19.2.3",
    "react-native": "0.85.3"
  }
}
